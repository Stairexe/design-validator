# Design Validator environment variables.
#
# Copy to `.env` at the repository root and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.
# Every runtime validates the variables it needs at startup (see packages/config).

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- PostgreSQL (packages/database) ------------------------------------------
# Used by docker-compose.yml to initialise the local database container.
POSTGRES_USER=design_validator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=design_validator
DATABASE_URL=postgresql://design_validator:change-me@localhost:5432/design_validator?schema=public

# --- Redis / BullMQ (packages/jobs) ------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (packages/storage) ---------------------------------------
# "memory" keeps artifacts in-process (tests / quick local runs only).
# "s3" targets any S3-compatible service (AWS S3, MinIO, Cloudflare R2, ...).
STORAGE_DRIVER=s3
S3_BUCKET=design-validator-local
S3_REGION=us-east-1
# Leave empty for AWS. For local MinIO (docker-compose.yml) use http://localhost:9000
S3_ENDPOINT=http://localhost:9000
# true for MinIO and most self-hosted S3-compatible services
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me-too

# --- Web app (apps/web) ------------------------------------------------------
APP_URL=http://localhost:3000

# --- Figma (packages/figma-parser, Phase 3) ----------------------------------
# Optional until the Figma importer is implemented.
FIGMA_ACCESS_TOKEN=

# --- Anthropic (packages/ai, Phase 8) ----------------------------------------
# Optional. AI recommendations are disabled when unset; deterministic audits still complete.
ANTHROPIC_API_KEY=
