# Design Validator environment variables.
#
# Copy to `.env` at the repository root and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.
# Every runtime validates the variables it needs at startup.
# Only the storage driver is required; everything else has a safe default.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# --- Persistence (packages/database) ----------------------------------------
# With DATABASE_URL: PostgreSQL via Prisma (recommended). Without it: JSON
# documents in the configured object storage (small single-tenant deployments).
# Used by docker-compose.yml to initialise the local database container.
POSTGRES_USER=design_validator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=design_validator
DATABASE_URL=postgresql://design_validator:change-me@localhost:5432/design_validator?schema=public

# --- Audit execution ---------------------------------------------------------
# inline: the web process runs audits (default; required on Vercel).
# queue:  stages run on the BullMQ workers in workers/ (requires REDIS_URL).
AUDIT_EXECUTION=inline
REDIS_URL=redis://localhost:6379

# --- Object storage (packages/storage) ---------------------------------------
# memory      in-process only (tests / quick single-process runs)
# filesystem  local disk under STORAGE_DIR
# s3          any S3-compatible service (AWS S3, MinIO, Cloudflare R2, ...)
# vercel-blob Vercel Blob in private mode (BLOB_READ_WRITE_TOKEN)
STORAGE_DRIVER=s3
STORAGE_DIR=.data/storage
S3_BUCKET=design-validator-local
S3_REGION=us-east-1
# Leave empty for AWS. For local MinIO (docker-compose.yml) use http://localhost:9000
S3_ENDPOINT=http://localhost:9000
# true for MinIO and most self-hosted S3-compatible services
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me-too
BLOB_READ_WRITE_TOKEN=

# --- Website inspector -------------------------------------------------------
# Allows localhost/private targets. Development only; keep false in production.
INSPECTOR_ALLOW_PRIVATE_HOSTS=false
# Optional explicit Chromium binary (otherwise the Playwright registry is used).
CHROMIUM_EXECUTABLE_PATH=

# --- Web app (apps/web) ------------------------------------------------------
APP_URL=http://localhost:3000
# Optional password gate for public deployments (HTTP Basic, any user name).
APP_ACCESS_PASSWORD=
# Secret Vercel Cron sends to /api/cron/cleanup.
CRON_SECRET=

# --- Limits and retention ----------------------------------------------------
RATE_LIMIT_AUDITS_PER_HOUR=30
RATE_LIMIT_AI_PER_HOUR=60
RATE_LIMIT_WRITES_PER_MINUTE=60
MAX_CONCURRENT_AUDITS=2
MAX_AUDITS_PER_DAY=200
AUDIT_RETENTION_DAYS=30

# --- Figma (packages/figma-parser) -------------------------------------------
# Optional personal access token. Enables Figma file URLs and frame image
# exports; uploaded Figma exports work without it.
FIGMA_ACCESS_TOKEN=

# --- Anthropic (packages/ai) -------------------------------------------------
# Optional. AI recommendations are disabled when unset; deterministic audits still complete.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# --- Source mapping (packages/source-mapper) ---------------------------------
# Optional; raises GitHub's anonymous rate limit for public repositories.
GITHUB_TOKEN=
