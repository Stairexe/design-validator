{
  "name": "design-validator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @design-validator/web test:e2e",
    "db:generate": "pnpm --filter @design-validator/database db:generate",
    "db:migrate": "pnpm --filter @design-validator/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @design-validator/database db:migrate:deploy",
    "db:check": "pnpm --filter @design-validator/database db:check",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@design-validator/database": "workspace:*",
    "@design-validator/jobs": "workspace:*",
    "@eslint/js": "9.39.5",
    "eslint-config-next": "16.3.8",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
