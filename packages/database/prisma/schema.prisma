// Design Validator relational model.
//
// Durable metadata only (architecture.md, "Storage"). Screenshots, normalized
// DesignSpec snapshots and full report JSON live in object storage; rows keep
// the object key. There is deliberately no score column anywhere: audits
// produce differences, not page-quality scores.
//
// Issue rows keep searchable columns plus the full ValidationIssue JSON
// (packages/design-spec); the complete report JSON lives in object storage.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Mirrors AUDIT_STATUSES in @design-validator/jobs (checked by a repository test).
enum AuditStatus {
  QUEUED
  INSPECTING_WEBSITE
  IMPORTING_DESIGN
  NORMALIZING
  MATCHING
  COMPARING
  VISUAL_DIFF
  AI_RECOMMENDATIONS
  COMPLETED
  FAILED
  CANCELLED
}

enum StageRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum DesignSourceType {
  FIGMA
  ADOBE_XD
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id               String         @id @default(cuid())
  name             String
  /// Canonical website URL. Validated server-side before any inspection.
  websiteUrl       String
  /// Optional until multi-user accounts exist; single-workspace deployments leave it empty.
  ownerId          String?
  owner            User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Source repository for code mapping (Phase 10), e.g. { provider, owner, repo, ref }.
  sourceRepository Json?
  designSources DesignSource[]
  audits        Audit[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([ownerId])
}

/// A design revision to validate against. Provider credentials are never stored here.
model DesignSource {
  id                String           @id @default(cuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type              DesignSourceType
  name              String
  /// Figma file URL, when applicable.
  uri               String?
  /// Provider identifier, e.g. the Figma file key.
  externalId        String?
  /// Provider revision/version, when known.
  revision          String?
  /// Selectable target frames/artboards: [{ nodeId, name, width, height }].
  frames            Json              @default("[]")
  /// Object-storage key of an uploaded Figma nodes export or Adobe XD manifest.
  uploadObjectKey   String?
  audits            Audit[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([projectId])
}

model Audit {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  designSourceId String
  designSource   DesignSource    @relation(fields: [designSourceId], references: [id], onDelete: Cascade)
  /// URL as submitted for this audit (the project URL may change later).
  websiteUrl     String
  /// Target page/frame/node in the design source.
  targetNodeId   String?
  status         AuditStatus     @default(QUEUED)
  /// Requested viewports, e.g. [{ "id": "desktop", "width": 1440, "height": 900 }].
  viewports      Json
  /// Tolerances and feature flags (visual diff, AI recommendations).
  settings       Json
  /// Hash of the audit inputs; part of every stage idempotency key.
  inputHash      String
  /// Latest progress event: { stage, message, progress }.
  progress        Json?
  /// Typed failure code (PipelineFailureCode) when status is FAILED.
  failureCode     String?
  failureMessage  String?
  /// Difference counts per category (navigation aid, not a score).
  counts          Json?
  issueCount      Int              @default(0)
  unresolvedCount Int              @default(0)
  warnings        Json             @default("[]")
  /// Audit this one re-validates (Phase 11).
  parentAuditId   String?
  stageRuns       AuditStageRun[]
  issues          Issue[]
  recommendations Recommendation[]
  queuedAt       DateTime        @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([projectId, createdAt])
  @@index([status])
}

/// One unit of stage work (optionally per viewport). The idempotency key makes
/// retries update the same row instead of duplicating work.
model AuditStageRun {
  id             String         @id @default(cuid())
  auditId        String
  audit          Audit          @relation(fields: [auditId], references: [id], onDelete: Cascade)
  /// Non-terminal AuditStatus value naming the stage.
  stage          AuditStatus
  viewportId     String?
  idempotencyKey String         @unique
  status         StageRunStatus @default(PENDING)
  attempt        Int            @default(1)
  failureCode    String?
  failureMessage String?
  /// Stage observability counters, e.g. { "elementCount": 412 }.
  metrics        Json?
  /// Object-storage keys produced by the stage (spec snapshot, screenshot, ...).
  artifactKeys   Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([auditId, stage])
}

/// One measured difference. `data` holds the full ValidationIssue; the other
/// columns exist for filtering.
model Issue {
  id               String  @id @default(cuid())
  auditId          String
  audit            Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  /// Deterministic ValidationIssue.id (stable across re-comparisons).
  issueId          String
  viewportId       String
  category         String
  severity         String
  status           String
  property         String
  elementName      String
  designId         String?
  implementationId String?
  position         Int
  data             Json

  @@unique([auditId, issueId])
  @@index([auditId, viewportId, category])
}

/// Cached AI recommendation for an issue group. Never alters measured values.
model Recommendation {
  id            String   @id @default(cuid())
  /// hash(audit input + element + issue set + prompt version + model)
  cacheKey      String   @unique
  auditId       String
  audit         Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  issueIds      Json
  payload       Json
  model         String
  promptVersion String
  createdAt     DateTime @default(now())

  @@index([auditId])
}
